# Copie este arquivo para ".env" e ajuste para o seu ambiente.
APP_ENV=dev
MSSQL_SERVER=localhost
MSSQL_DB=bioliftvisionDB
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
# Autenticação integrada do Windows (recomendado em desenvolvimento)
MSSQL_TRUSTED=true
# Ou autenticação SQL Server: defina MSSQL_TRUSTED=false e preencha abaixo
# MSSQL_USER=
# MSSQL_PASSWORD=
MSSQL_ENCRYPT=yes
MSSQL_TRUST_SERVER_CERT=yes
MSSQL_TIMEOUT=30
